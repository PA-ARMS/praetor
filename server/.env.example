# Virginia Legal AI - Environment Configuration
# Copy this file to .env and set your values. Do not commit .env to version control.
# Required for production: JWT_SECRET, ENCRYPTION_KEY, and restrict CORS_ORIGINS.

# === Server ===
HOST=0.0.0.0
PORT=5001
DEBUG=false

# === Ollama (local LLM) ===
# Smaller default: llama3.2:1b. Legal: initium/law_model. Pull: ollama run <model>
OLLAMA_BASE_URL=http://localhost:11434
# Use a name from `ollama list`. tinyllama:latest is smallest; initium/law_model:latest needs GPU (see RESTART_EVERYTHING.bat).
OLLAMA_MODEL=llama3.2:1b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# -1 = GPU only (Ollama default; chat runs on GPU). 0 = CPU only. 20–40 = split CPU/GPU.
OLLAMA_NUM_GPU=-1
# Prompt context (tokens). 8192 is faster; use 16384–32768 only for very long attachments.
OLLAMA_NUM_CTX=8192

# Chat speed (simple endpoint)
CHAT_RAG_MAX_VARIATIONS=4
CHAT_SIMPLE_N_RESULTS=8
CHAT_SIMPLE_MAX_OUTPUT_TOKENS=768
# BGE=true speeds RAG (local embed) but uses VRAM; false uses Ollama nomic-embed (slower per search)
BGE_EMBEDDINGS_ENABLED=false

# === Database ===
DATABASE_URL=sqlite:///./data/legal_ai.db

# === RAG / Vector DB ===
CHROMA_DB_PATH=./data/chroma_db
EMBEDDING_DIMENSION=768

# === Semantic response cache (similar questions reuse answers; skips RAG + LLM on hit) ===
SEMANTIC_CACHE_ENABLED=true
# Cosine similarity threshold 0.0–1.0 (higher = stricter match only)
SEMANTIC_CACHE_MIN_SIMILARITY=0.88
SEMANTIC_CACHE_MAX_CANDIDATES=400
SEMANTIC_CACHE_MAX_PER_USER=2000

# === Security (REQUIRED for production) ===
# Run: python scripts/production_setup.py  (generates secrets and sets production config)
JWT_SECRET=change-this-secret-key
ENCRYPTION_KEY=change-this-32-char-encryption-key

# === Network ===
ALLOWED_IPS=192.168.1.0/24,127.0.0.1
# Production: Use JSON array. Add your LAN IP for network access.
#   CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://192.168.1.100:3000"]
CORS_ORIGINS=*

# === File uploads ===
MAX_FILE_SIZE=52428800
ALLOWED_FILE_EXTENSIONS=.pdf,.txt,.docx,.html,.htm,.md

# === Password policy ===
MIN_PASSWORD_LENGTH=12
REQUIRE_PASSWORD_COMPLEXITY=true

# === Rate limiting ===
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_PER_MINUTE=30
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_DEFAULT_PER_MINUTE=60

# === Token expiration (hours) ===
ACCESS_TOKEN_EXPIRE_HOURS=24

# === Paths (defaults) ===
DATA_DIR=./data
FORMS_DIR=./data/forms
TEMPLATES_DIR=./data/templates
CORPUS_DIR=./data/corpus
AUDIO_DIR=./data/audio

# === Scenario DB (optional feature) ===
# False = chat-only (only chat LLM runs; no scenario embeddings). Set True to re-enable Scenario Analysis.
SCENARIO_DB_ENABLED=false
SCENARIO_DB_PATH=./data/scenario_db

# === Document Pipeline (parallel models) ===
# Tuned for 32 GB RAM + RTX 5070 Ti; disable individual flags on lower-spec systems if needed
DOCUMENT_READER_ENABLED=true
NEURAL_OCR_ENABLED=true
SUMMARIZATION_MODEL_ENABLED=true
# BGE recommended when GPU has ~16 GB VRAM for better RAG embeddings; Ollama then used for chat only
BGE_EMBEDDINGS_ENABLED=true
ENTITY_EXTRACTION_ENABLED=true
TABLE_EXTRACTION_ENABLED=true
# Second pass: Ollama JSON extraction (parties, amounts, issues). Set false to skip extra LLM call on upload.
DOCUMENT_LLM_EXTRACTION_ENABLED=true

# === Live official lookup during chat (no API keys) ===
# Fetches current statute text from law.lis.virginia.gov and other allowlisted .gov sites.
LIVE_LEGAL_LOOKUP_ENABLED=true
LIVE_LEGAL_LOOKUP_TIMEOUT_SECONDS=8

# === API keys (optional; for download scripts) ===
COURTLISTENER_API_KEY=
CAP_API_KEY=

# === Ingestion limits (for full legal coverage build) ===
# Override defaults when running scripts/ingest_sources.py or verify_and_complete_database.py
# MAX_INGEST_PER_SOURCE=5000
# MAX_INGEST_TOTAL=50000
